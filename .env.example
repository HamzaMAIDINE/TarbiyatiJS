# Local development. Production requires NODE_ENV=production and an HTTPS origin.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=
# Comma-separated IP addresses of reverse proxies you control.
TRUSTED_PROXIES=
# Optional private directory; defaults to Web_NodeJs/.data.
DATA_DIR=
BACKUP_INTERVAL_HOURS=24

# Verified accounts matching this comma-separated list can access administration.
ADMIN_EMAIL=

# Configure either Brevo HTTPS or authenticated SMTP for email delivery.
# Without a transport, development writes messages to the private mail directory.
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_KEY=
SMTP_FROM=
SMTP_FROM_NAME="Tarbiyati · تربيتي"

# Optional production HTTPS email gateway.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
