# Free Brevo SMTP: https://app.brevo.com/settings/keys/smtp
# Copy this file to .env and fill in SMTP_USER, SMTP_KEY and SMTP_FROM.
# Keep credentials in .env or your hosting environment; never in this template.
# With all three blank, local development saves previews to .data/mail/.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Use a Brevo SMTP key, not an API key or your account password.
SMTP_KEY=
# An email address you have added and verified as a sender in Brevo.
SMTP_FROM=
SMTP_FROM_NAME="Tarbiyati.com · تربيتي"
# Admin email address (grants access to /pages/admin.html and /api/admin/*)
ADMIN_EMAIL=

# Development defaults. Configure these in the hosting environment for production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Required in production; also set this when using a public development tunnel.
PUBLIC_ORIGIN=
# Use an absolute persistent path in production. Blank uses .data/ locally.
DATA_DIR=
# Comma-separated IP addresses of your actual reverse proxies only.
TRUSTED_PROXIES=
BACKUP_INTERVAL_HOURS=24
# Optional HTTPS email gateway instead of SMTP (production only).
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
